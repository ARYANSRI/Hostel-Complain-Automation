# =================================================================
# FIXBIT - ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. Google Gemini AI Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-2.0-flash,gemini-3.5-flash

# -----------------------------------------------------------------
# 2. Notion Integration (Optional - Works in local demo mode if unset)
# Create integration at: https://www.notion.so/my-integrations
# -----------------------------------------------------------------
NOTION_TOKEN=
COMPLAINTS_DATABASE_ID=
VENDORS_DATABASE_ID=

# -----------------------------------------------------------------
# 3. Mailtrap / SMTP Email Configuration (Optional)
# Get sandbox credentials at: https://mailtrap.io
# -----------------------------------------------------------------
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAIL_FROM=noreply@fixbit.local
